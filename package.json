{
  "name": "ai-storyteller-engine-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:backend": "npx pnpm --filter @openclaw/server dev",
    "dev:ui": "npx pnpm --filter @openclaw/ui dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:ui\"",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.8",
    "concurrently": "^9.2.1",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
